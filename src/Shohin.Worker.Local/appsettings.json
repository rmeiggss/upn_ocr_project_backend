{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "UseInMemory"
  },
  "ScanFolder": {
    "Path": "ScanStation",
    "IntervalSeconds": 5
  },
  "BlobStorage": {
    "Provider": "Local",
    "LocalPath": "App_Data/Blobs",
    "BaseUrl": "/api/documentos/archivo/"
  },
  "Ocr": {
    "Provider": "Mock"
  }
}
